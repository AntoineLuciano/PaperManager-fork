# Neo4j Aura
NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Google Drive
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CREDENTIALS_FILE=
GOOGLE_TOKEN_FILE=

# Anthropic (personal)
ANTHROPIC_API_KEY=

# Anthropic (work / Foundry enterprise gateway)
ANTHROPIC_WORK_API_KEY=
ANTHROPIC_WORK_BASE_URL=

# SSL — corporate proxy / TLS proxy
# Set SSL_VERIFY=false to disable certificate verification (quick fix)
# Or set SSL_CA_BUNDLE=/path/to/corporate-ca.pem to trust the corporate cert
SSL_VERIFY=true
SSL_CA_BUNDLE=

# LiteLLM proxy (chat + embeddings)
LITELLM_ENDPOINT=https://litellm.example.internal
LITELLM_API_KEY=
LITELLM_MODEL=google/gemma-4-26b-a4b-it
LITELLM_EMBED_MODEL=openrouter/nomic-ai/nomic-embed-text

# Docling (layout / figures / chapters) via inference manager
DOCLING_MODE=on_demand
INFERENCE_MANAGER_URL=https://inference-manager.example.internal
HERMIONE_HOST=203.0.113.10
DOCLING_HOST_PORT=8004
DOCLING_READY_TIMEOUT=600
# DOCLING_SERVE_URL=

# App
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
JWT_SECRET_KEY=
DEFAULT_USER_NAME=niklas
DEFAULT_USER_PASSWORD=

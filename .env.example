# PaperManager settings. Copy to .env (git-ignored) and fill in.
# Easiest path: give DEPLOY.md to your coding agent (Claude Code, Codex, ...); it asks you a few
# questions and writes this file for you. Everything below "Optional" can stay as it is.
# Keep comments on their own lines: Docker reads "KEY=   # note" as the value "# note".

# ── 1. Required ───────────────────────────────────────────────────────────────
# Your login name (the owner/admin account). Its password is set with create_default_user.py.
DEFAULT_USER_NAME=me
DEFAULT_USER_PASSWORD=
# openssl rand -hex 32
JWT_SECRET_KEY=
# Any long random string; Docker creates the database with it.
NEO4J_PASSWORD=

# ── 2. AI: one key is enough ──────────────────────────────────────────────────
# Summaries, topics, claims and the concept map use a fast, cheap model; chat can use Claude.
# AI_PROVIDER=auto picks the first one configured: LiteLLM proxy, then Anthropic, then OpenAI.
#   Anthropic only: fast tasks on Claude Haiku 4.5, chat on Claude Sonnet/Opus
#   OpenAI only:    fast tasks and chat on GPT-5 mini
# Keys: https://console.anthropic.com and https://platform.openai.com
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# auto | anthropic | openai | litellm
AI_PROVIDER=auto
# Empty = the provider's default (claude-haiku-4-5-20251001, gpt-5-mini, LITELLM_MODEL).
FAST_MODEL=

# ── 3. Where PDFs are stored ──────────────────────────────────────────────────
# auto = Google Drive when GOOGLE_DRIVE_FOLDER_ID is set, otherwise a local Docker volume.
# auto | local | drive. For Drive see docs/self_hosting.md, step 2.
STORAGE_BACKEND=auto
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CREDENTIALS_FILE=
GOOGLE_TOKEN_FILE=

# ── 4. Look ───────────────────────────────────────────────────────────────────
# violet | blue | teal | green | amber | rose | slate | any #RRGGBB
UI_ACCENT=violet

# ── Optional ──────────────────────────────────────────────────────────────────
# Any OpenAI-compatible proxy or API (LiteLLM, OpenRouter, Ollama, vLLM) for the fast tasks.
LITELLM_ENDPOINT=
LITELLM_API_KEY=
LITELLM_MODEL=google/gemma-4-26b-a4b-it
LITELLM_EMBED_MODEL=

# Claude Code on your own Claude Pro/Max subscription (model option "Claude Code").
# A subscription is personal: list only its owner. Empty disables the option.
# The token comes from `claude setup-token`.
CLAUDE_CODE_USERS=
CLAUDE_CODE_OAUTH_TOKEN=

# Anthropic work / enterprise gateway
ANTHROPIC_WORK_API_KEY=
ANTHROPIC_WORK_BASE_URL=

# PDF layout model (Docling): "local" runs in the app container (needs ~2 GB RAM).
DOCLING_MODE=local
INFERENCE_MANAGER_URL=
HERMIONE_HOST=
DOCLING_HOST_PORT=8004
DOCLING_READY_TIMEOUT=600
# DOCLING_SERVE_URL=

# Corporate TLS-intercepting proxy: SSL_VERIFY=false, or SSL_CA_BUNDLE=/path/to/ca.pem
SSL_VERIFY=true
SSL_CA_BUNDLE=

# Port on this computer for docker-compose.selfhost.yml (http://localhost:PM_PORT).
PM_PORT=8080

# Set by docker-compose.selfhost.yml; only needed for other setups.
# NEO4J_URI=neo4j+s://xxxx.databases.neo4j.io
# NEO4J_USER=neo4j
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:8080
